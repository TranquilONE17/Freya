# Python virtual environment
.venv/
venv/
env/

# Python cache / compiled files
__pycache__/
*.py[cod]
*$py.class

# Build artifacts
*.egg-info/
build/
dist/

# Environment variables / secrets
.env
.env.*
!.env.example

# Logs
*.log
logs/

# Testing / coverage
.pytest_cache/
.coverage
htmlcov/

# Type checking / linting
.mypy_cache/
.ruff_cache/

# VS Code local settings
.vscode/

# Operating system files
.DS_Store
Thumbs.db
desktop.ini

# Freya's local data: memories, audit log, settings, generated images,
# and the window's browser profile
data/

# Databases / local memory
*.db
*.db-wal
*.db-shm
*.sqlite
*.sqlite3

# AI models / large model files
models/
*.gguf
*.safetensors
*.bin
*.pt
*.pth
*.onnx

# Temporary files
tmp/
temp/
*.tmp

# Credentials / keys
*.key
*.pem
credentials.json
secrets.json
# Local development/test files
barge_in_stage2_stt_backup.patch
barge_in_stage2_stt_backup.py
src/freya/mic_level_test.py
barge_in_stage2_main_backup.patch
barge_in_stage2_main_backup.py

# Unreal client: source is kept here; assets and build output are not.
# MetaHuman assets must not be committed (Epic's terms; see the design note).
clients/unreal/*/Content/
clients/unreal/*/Binaries/
clients/unreal/*/Intermediate/
clients/unreal/*/Saved/
clients/unreal/*/Packaged/
clients/unreal/*/DerivedDataCache/
clients/unreal/*/Build/
clients/unreal/*/Fixtures/*.wav
clients/unreal/*/Fixtures/*.f32
